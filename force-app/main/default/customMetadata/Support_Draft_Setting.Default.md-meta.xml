        <value xsi:type="xsd:double">0.45</value>
    </values>
    <!-- Matches the live org: demote mode keeps reviewable [NEEDS REVIEW] drafts flowing; the
         2026-07-22 anti-hallucination code blocks fabrication/grounding failures regardless of mode. -->
    <values>
        <field>Draft_Gate_Mode__c</field>
        <value xsi:type="xsd:string">demote</value>
