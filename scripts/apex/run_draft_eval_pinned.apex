/**
 * run_draft_eval_pinned.apex — re-run the draft eval on the PINNED 2026-07-15 cohort (the exact
 * 100 caseIds from docs/eval-run-2026-07-15.csv) so before/after comparisons isolate pipeline
 * changes from cohort variance. Dry run: zero Case writes, one ContentVersion CSV.
 *
 * NOTE: distillation is sampled (unseeded GPT-4o), so +/-3-4 individual cases flip between runs —
 * compare aggregates, never individual cases.
 *
 * Run: sf apex run -f scripts/apex/run_draft_eval_pinned.apex -o vscodeOrg
 */
String RUN_LABEL = 'eval-pinned-2026-07-20-precision';

