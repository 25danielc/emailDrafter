/**
 * run_draft_eval_fresh4.apex - Phase-1 fresh-cohort measurement (2026-07-23): 250 UNSEEN cases
 * per docs/measurement-protocol-2026-07-23.md. Excludes every case seen in ANY prior eval run
 * (554 ids from docs/eval-run-*.csv). Chain cap is ~120 cases, so the 250 sampled ids run as
 * THREE chains ('-b1' 100 / '-b2' 100 / '-b3' 50); merge the CSVs after all complete.
 *
 * Run: sf apex run -f scripts/apex/run_draft_eval_fresh4.apex -o vscodeOrg
 */

Boolean DRY_PREVIEW  = false;
Integer COHORT_LIMIT = 250;
Integer CANDIDATE_POOL = 1500;
String  RUN_LABEL    = 'eval-fresh250-2026-07-23r2';
String  COHORT_SOQL  =
      'SELECT Id, CaseNumber, Subject, Description, Product_List__c, CreatedDate FROM Case '
    + 'WHERE Origin = \'Email\' AND Subject != null '
    + 'AND (NOT Subject LIKE \'%SANDBOX TEST%\') '
    + 'AND AI_Draft_Status__c = null '
    + 'AND CreatedDate = LAST_N_DAYS:365 '
    + 'ORDER BY CreatedDate DESC LIMIT ' + CANDIDATE_POOL;

