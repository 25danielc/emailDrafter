    '500UW000016sWLVYA2', '500UW000016TNB5YAO', '500UW000016tt81YAA', '500UW000016uR3FYAU', '500UW000016UT2IYAW',
    '500UW000016v4EHYAY', '500UW000016VuEsYAK', '500UW000016wSfvYAE', '500UW000016WssbYAC', '500UW000016xQNXYA2',
    '500UW000016Y5sYYAS', '500UW000016YuwpYAC', '500UW0000170TVNYA2', '500UW0000171Jk2YAE', '500UW0000174yfWYAQ',
    '500UW000017cTVvYAM', '500UW000017DDnlYAG', '500UW000017DmqLYAS', '500UW000017EUY4YAO', '500UW000017eVLcYAM',
    '500UW000017EY3kYAG', '500UW000017FjI1YAK', '500UW000017GGnRYAW', '500UW000017HISJYA4', '500UW000017M31GYAS',
    '500UW000017MYJSYA4', '500UW000017NGAoYAO', '500UW000017NVJfYAO', '500UW000017P3atYAC', '500UW000017PsLgYAK',
    '500UW000017QXOnYAO', '500UW000017UBT2YAO', '500UW000017UCdXYAW', '500UW000017ZCjNYAW'
};
System.assertEquals(354, SEEN.size(), 'Seen-id exclusion list must be the full 354');

List<Case> pool = new List<Case>();
for (Case c : (List<Case>) Database.query(COHORT_SOQL)) {
    if (!String.isBlank(c.Description) && !SEEN.contains(c.Id)) { pool.add(c); }
}

// SOQL has no random ordering: Fisher-Yates the candidate pool, then take the first COHORT_LIMIT.
for (Integer i = pool.size() - 1; i > 0; i--) {
    Integer j = (Integer) Math.floor(Math.random() * (i + 1));
    Case tmp = pool[i]; pool[i] = pool[j]; pool[j] = tmp;
}
List<Case> cohort = new List<Case>();
Map<String, Integer> byProduct = new Map<String, Integer>();
for (Case c : pool) {
    if (cohort.size() >= COHORT_LIMIT) { break; }
    cohort.add(c);
    String p = String.isBlank(c.Product_List__c) ? '(blank)' : c.Product_List__c;
    Integer n = byProduct.get(p);
    byProduct.put(p, (n == null ? 0 : n) + 1);
}

System.debug(LoggingLevel.ERROR, 'Candidate pool after exclusions: ' + pool.size()
    + ' cases; sampled cohort: ' + cohort.size() + ' (target ' + COHORT_LIMIT + ').');
System.debug(LoggingLevel.ERROR, 'Cohort by product: ' + JSON.serialize(byProduct));
for (Integer i = 0; i < Math.min(10, cohort.size()); i++) {
    String subj = cohort[i].Subject;
    if (subj.length() > 60) { subj = subj.substring(0, 60) + '...'; }
    System.debug(LoggingLevel.ERROR, '  sample[' + i + '] ' + cohort[i].CaseNumber + '  ' + subj);
}

if (DRY_PREVIEW) {
    System.debug(LoggingLevel.ERROR, 'DRY_PREVIEW = true: nothing enqueued. Flip to false to run.');
} else if (cohort.size() < COHORT_LIMIT) {
    System.debug(LoggingLevel.ERROR, 'Cohort short of target (' + cohort.size()
        + '); widen CANDIDATE_POOL before running.');
} else {
    List<Id> ids1 = new List<Id>();
    List<Id> ids2 = new List<Id>();
    for (Integer i = 0; i < cohort.size(); i++) {
        if (i < 100) { ids1.add(cohort[i].Id); } else { ids2.add(cohort[i].Id); }
    }
    Id job1 = System.enqueueJob(new DraftEvalBatchJob(ids1, RUN_LABEL + '-b1'));
    Id job2 = System.enqueueJob(new DraftEvalBatchJob(ids2, RUN_LABEL + '-b2'));
    System.debug(LoggingLevel.ERROR, 'Enqueued two DraftEvalBatchJob chains: ' + job1 + ' (b1, '
        + ids1.size() + ' cases) and ' + job2 + ' (b2, ' + ids2.size() + ' cases). Monitor with:');
    System.debug(LoggingLevel.ERROR, '  SELECT Status, ExtendedStatus, CreatedDate FROM AsyncApexJob '
        + 'WHERE ApexClass.Name = \'DraftEvalBatchJob\' ORDER BY CreatedDate DESC LIMIT 25');
    System.debug(LoggingLevel.ERROR, 'When both finish, run scripts/apex/fetch_draft_eval.apex.');
}
