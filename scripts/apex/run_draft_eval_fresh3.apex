/**
 * run_draft_eval_fresh3.apex - dry-run the draft pipeline over 200 UNSEEN cases (2026-07-23).
 *
 * Same harness as run_draft_eval_fresh2.apex but COHORT_LIMIT=200: excludes every case seen in
 * ANY prior eval run (354 ids from docs/eval-run-*.csv, incl. the pinned cohort and today's
 * eval-fresh-2026-07-23 100). DraftEvalBatchJob's MAX_DEPTH backstop caps one chain at 120
 * cases, so the 200 sampled ids are enqueued as TWO 100-case chains ('-b1' / '-b2'); merge the
 * two CSVs after both complete.
 *
 * Run: sf apex run -f scripts/apex/run_draft_eval_fresh3.apex -o vscodeOrg
 */

// ===================== EDITABLE COHORT =====================
Boolean DRY_PREVIEW  = true;            // true = print the sampled cohort only; false = enqueue the runs (2026-07-23 fresh200 run already taken)
Integer COHORT_LIMIT = 200;
Integer CANDIDATE_POOL = 1200;          // exclusions (354) + blank descriptions eat the pool
String  RUN_LABEL    = 'eval-fresh200-2026-07-23';   // '-b1' / '-b2' appended per chain
String  COHORT_SOQL  =
      'SELECT Id, CaseNumber, Subject, Description, Product_List__c, CreatedDate FROM Case '
    + 'WHERE Origin = \'Email\' AND Subject != null '
    + 'AND (NOT Subject LIKE \'%SANDBOX TEST%\') '   // internal test emails skew the stats
    + 'AND AI_Draft_Status__c = null '
    + 'AND CreatedDate = LAST_N_DAYS:365 '
    + 'ORDER BY CreatedDate DESC LIMIT ' + CANDIDATE_POOL;
// ===========================================================

// Every caseId from prior eval CSVs in docs/ (generated by scratchpad seen_case_ids.txt).
Set<Id> SEEN = new Set<Id>{
