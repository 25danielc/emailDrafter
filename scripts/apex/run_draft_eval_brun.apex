/**
 * run_draft_eval_brun.apex — re-run the draft eval on the EXACT 100-case cohort of the 2026-07-20b
 * fresh run (the cohort whose 21 drafts were reviewer-labeled 11 good / 10 FP in
 * docs/eval-drafts-reviewed-2026-07-20b.csv). This is the correct cohort for verifying the precision
 * gates (LLM verification gate + claim check) against the known false positives.
 *
 * NOTE: distillation AND the verify gate are sampled (unseeded), so +/-3-4 individual cases flip
 * between runs — compare aggregates (drafted-case precision), not individual cases.
 *
 * Run: sf apex run -f scripts/apex/run_draft_eval_brun.apex -o vscodeOrg
 */
String RUN_LABEL = 'eval-brun-2026-07-20-precision';

