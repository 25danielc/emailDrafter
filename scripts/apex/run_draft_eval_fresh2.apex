/**
 * run_draft_eval_fresh2.apex - dry-run the draft pipeline over 100 UNSEEN cases (2026-07-23).
 *
 * Same harness as run_draft_eval.apex (chained DraftEvalBatchJob, zero Case writes, one
 * ContentVersion CSV), but the sample additionally excludes every case that appeared in ANY
 * prior eval run (254 ids unioned from docs/eval-run-*.csv, incl. the pinned 2026-07-15 cohort),
 * so the cohort measures generalization, not the tuned-against set.
 *
 * Run: sf apex run -f scripts/apex/run_draft_eval_fresh2.apex -o vscodeOrg
 */

// ===================== EDITABLE COHORT =====================
Boolean DRY_PREVIEW  = true;            // true = print the sampled cohort only; false = enqueue the run (2026-07-23 run already taken)
Integer COHORT_LIMIT = 100;
Integer CANDIDATE_POOL = 700;           // extra headroom: exclusions + blank descriptions eat the pool
String  RUN_LABEL    = 'eval-fresh-2026-07-23';
String  COHORT_SOQL  =
      'SELECT Id, CaseNumber, Subject, Description, Product_List__c, CreatedDate FROM Case '
    + 'WHERE Origin = \'Email\' AND Subject != null '
    + 'AND (NOT Subject LIKE \'%SANDBOX TEST%\') '   // internal test emails skew the stats
    + 'AND AI_Draft_Status__c = null '
    + 'AND CreatedDate = LAST_N_DAYS:365 '
    + 'ORDER BY CreatedDate DESC LIMIT ' + CANDIDATE_POOL;
// ===========================================================

// Every caseId from prior eval CSVs in docs/ (generated by scratchpad seen_case_ids.txt).
Set<Id> SEEN = new Set<Id>{
    '500cW00000KcxA1QAJ', '500cW00000Kr4JnQAJ', '500cW00000KRjSjQAL', '500cW00000KWN4PQAX', '500cW00000KWZ5ZQAX',
    '500cW00000KZ1QjQAL', '500cW00000KZa9xQAD', '500UW0000118ljxYAA', '500UW0000119WpDYAU', '500UW000011aVfNYAU',
    '500UW000011ba9tYAA', '500UW000011bFn0YAE', '500UW000011Dn54YAC', '500UW000011eaenYAA', '500UW000011eOddYAE',
    '500UW000011epagYAA', '500UW000011evMhYAI', '500UW000011flEqYAI', '500UW000011FzS2YAK', '500UW000011G9JDYA0',
    '500UW000011GkfMYAS', '500UW000011hhbmYAA', '500UW000011if6VYAQ', '500UW000011iOggYAE', '500UW000011JgguYAC',
    '500UW000011kXzjYAE', '500UW000011lhwWYAQ', '500UW000011lsGtYAI', '500UW000011nBPRYA2', '500UW000011nL0cYAE',
    '500UW000011OU7AYAW', '500UW000011pGD0YAM', '500UW000011R3iJYAS', '500UW000011R9XaYAK', '500UW000011suFWYAY',
    '500UW000011uq4UYAQ', '500UW000011w9rWYAQ', '500UW000011X63xYAC', '500UW000011Y79GYAS', '500UW000011Y7VpYAK',
    '500UW000011Y94hYAC', '500UW000011ynKzYAI', '500UW000011Yx7sYAC', '500UW000011ZJA6YAO', '500UW0000124gGjYAI',
    '500UW0000125RquYAE', '500UW0000125u4rYAA', '500UW000012920yYAA', '500UW000012BxT1YAK', '500UW000012C2veYAC',
    '500UW000012CUofYAG', '500UW000012D2AUYA0', '500UW000012DmObYAK', '500UW000012F79GYAS', '500UW000012Hp1OYAS',
    '500UW000012i7lhYAA', '500UW000012Ifj2YAC', '500UW000012iKe5YAE', '500UW000012jvGeYAI', '500UW000012K02DYAS',
    '500UW000012k5BBYAY', '500UW000012L3MDYA0', '500UW000012lYRBYA2', '500UW000012MDxxYAG', '500UW000012mJgHYAU',
    '500UW000012mzacYAA', '500UW000012paZHYAY', '500UW000012PbPPYA0', '500UW000012pnhuYAA', '500UW000012PqbLYAS',
    '500UW000012SJHWYA4', '500UW000012tDmEYAU', '500UW000012tq2lYAA', '500UW000012VjfCYAS', '500UW000012w2cVYAQ',
    '500UW000012WFP1YAO', '500UW000012wptMYAQ', '500UW000012xUMzYAM', '500UW000012Y9KJYA0', '500UW000012yHNiYAM',
    '500UW000012zCLyYAM', '500UW000012Zjv5YAC', '500UW000012ZK5WYAW', '500UW000012zouOYAQ', '500UW000012zSTyYAM',
    '500UW000012zXWuYAM', '500UW0000133eI2YAI', '500UW0000134efnYAA', '500UW0000134ff9YAA', '500UW0000135sgfYAA',
    '500UW0000136glcYAA', '500UW0000136l6rYAA', '500UW000013ApwmYAC', '500UW000013BGC7YAO', '500UW000013bsaHYAQ',
    '500UW000013byFuYAI', '500UW000013e2fHYAQ', '500UW000013ex8rYAA', '500UW000013fzIIYAY', '500UW000013hbv3YAA',
    '500UW000013iGOfYAM', '500UW000013lrD9YAI', '500UW000013nFtRYAU', '500UW000013NYtEYAW', '500UW000013pmbaYAA',
    '500UW000013PSWnYAO', '500UW000013QIokYAG', '500UW000013RdXhYAK', '500UW000013RvUdYAK', '500UW000013S15SYAS',
    '500UW000013S4o3YAC', '500UW000013SxW2YAK', '500UW000013TSzdYAG', '500UW000013UjTjYAK', '500UW000013UuNXYA0',
    '500UW000013wOMHYA2', '500UW000013xdhVYAQ', '500UW000013xuDjYAI', '500UW000013XYYaYAO', '500UW000013Yo6kYAC',
    '500UW000013zt5QYAQ', '500UW0000141yCGYAY', '500UW000014bhxfYAA', '500UW000014bTBZYA2', '500UW000014C06HYAS',
    '500UW000014DeMcYAK', '500UW000014dG25YAE', '500UW000014DY14YAG', '500UW000014E8xPYAS', '500UW000014ezLOYAY',
    '500UW000014fkvVYAQ', '500UW000014GWvZYAW', '500UW000014haWtYAI', '500UW000014hjn4YAA', '500UW000014iCCRYA2',
    '500UW000014ielJYAQ', '500UW000014jKsbYAE', '500UW000014jpRoYAI', '500UW000014k8MNYAY', '500UW000014kr9sYAA',
    '500UW000014L0DcYAK', '500UW000014MfwDYAS', '500UW000014MMQWYA4', '500UW000014MQZ1YAO', '500UW000014NB4nYAG',
    '500UW000014pxzNYAQ', '500UW000014QEvnYAG', '500UW000014qfqhYAA', '500UW000014qfx7YAA', '500UW000014RcZYYA0',
    '500UW000014RvQoYAK', '500UW000014RYRAYA4', '500UW000014WteYYAS', '500UW000014y1zLYAQ', '500UW0000152lYwYAI',
    '500UW0000152TSOYA2', '500UW0000153ySZYAY', '500UW0000154AevYAE', '500UW0000154j83YAA', '500UW0000154RnqYAE',
    '500UW0000154UCIYA2', '500UW000015clfIYAQ', '500UW000015cpR7YAI', '500UW000015e0AsYAI', '500UW000015gOaQYAU',
    '500UW000015hqrDYAQ', '500UW000015hVmuYAE', '500UW000015Hz6zYAC', '500UW000015IO72YAG', '500UW000015jZ9kYAE',
    '500UW000015L04uYAC', '500UW000015londYAA', '500UW000015NTFdYAO', '500UW000015O755YAC', '500UW000015QxlpYAC',
    '500UW000015SpCLYA0', '500UW000015tgRRYAY', '500UW000015tZUqYAM', '500UW000015uVNaYAM', '500UW000015uxQNYAY',
    '500UW000015VBjpYAG', '500UW000015vbtvYAA', '500UW000015WGBBYA4', '500UW000015WxETYA0', '500UW000015xb6bYAA',
    '500UW000015YWWjYAO', '500UW000015zmUBYAY', '500UW000015zQNBYA2', '500UW000015Zwc3YAC', '500UW0000160Me6YAE',
    '500UW0000161cNTYAY', '500UW0000161eijYAA', '500UW0000161RvBYAU', '500UW0000167gwKYAQ', '500UW0000167hFdYAI',
    '500UW0000167k73YAA', '500UW0000167kQPYAY', '500UW0000167ppqYAA', '500UW0000167vfAYAQ', '500UW0000167xYvYAI',
    '500UW0000167ZbPYAU', '500UW0000168NEnYAM', '500UW0000168WjVYAU', '500UW0000168YlKYAU', '500UW00001692bLYAQ',
    '500UW000016a2dgYAA', '500UW000016aMCaYAM', '500UW000016eBqRYAU', '500UW000016ePVEYA2', '500UW000016EwPxYAK',
    '500UW000016FWJpYAO', '500UW000016GisRYAS', '500UW000016GTerYAG', '500UW000016hK5xYAE', '500UW000016hppiYAA',
    '500UW000016KeDUYA0', '500UW000016kmTzYAI', '500UW000016lOawYAE', '500UW000016MD5tYAG', '500UW000016nK8FYAU',
    '500UW000016nT8IYAU', '500UW000016nxayYAA', '500UW000016oJErYAM', '500UW000016slKaYAI', '500UW000016sQhcYAE',
    '500UW000016sWLVYA2', '500UW000016TNB5YAO', '500UW000016tt81YAA', '500UW000016uR3FYAU', '500UW000016UT2IYAW',
    '500UW000016v4EHYAY', '500UW000016VuEsYAK', '500UW000016wSfvYAE', '500UW000016WssbYAC', '500UW000016xQNXYA2',
    '500UW000016Y5sYYAS', '500UW000016YuwpYAC', '500UW0000170TVNYA2', '500UW0000171Jk2YAE', '500UW000017DDnlYAG',
    '500UW000017DmqLYAS', '500UW000017EUY4YAO', '500UW000017eVLcYAM', '500UW000017EY3kYAG', '500UW000017HISJYA4',
    '500UW000017M31GYAS', '500UW000017MYJSYA4', '500UW000017NGAoYAO', '500UW000017NVJfYAO', '500UW000017P3atYAC',
    '500UW000017PsLgYAK', '500UW000017QXOnYAO', '500UW000017UBT2YAO', '500UW000017UCdXYAW'
};
System.assertEquals(254, SEEN.size(), 'Seen-id exclusion list must be the full 254');

List<Case> pool = new List<Case>();
for (Case c : (List<Case>) Database.query(COHORT_SOQL)) {
    if (!String.isBlank(c.Description) && !SEEN.contains(c.Id)) { pool.add(c); }
}

// SOQL has no random ordering: Fisher-Yates the candidate pool, then take the first COHORT_LIMIT.
for (Integer i = pool.size() - 1; i > 0; i--) {
    Integer j = (Integer) Math.floor(Math.random() * (i + 1));
    Case tmp = pool[i]; pool[i] = pool[j]; pool[j] = tmp;
}
List<Case> cohort = new List<Case>();
Map<String, Integer> byProduct = new Map<String, Integer>();
for (Case c : pool) {
    if (cohort.size() >= COHORT_LIMIT) { break; }
    cohort.add(c);
    String p = String.isBlank(c.Product_List__c) ? '(blank)' : c.Product_List__c;
    Integer n = byProduct.get(p);
    byProduct.put(p, (n == null ? 0 : n) + 1);
}

System.debug(LoggingLevel.ERROR, 'Candidate pool after exclusions: ' + pool.size()
    + ' cases; sampled cohort: ' + cohort.size() + ' (target ' + COHORT_LIMIT + ').');
System.debug(LoggingLevel.ERROR, 'Cohort by product: ' + JSON.serialize(byProduct));
for (Integer i = 0; i < Math.min(10, cohort.size()); i++) {
    String subj = cohort[i].Subject;
    if (subj.length() > 60) { subj = subj.substring(0, 60) + '...'; }
    System.debug(LoggingLevel.ERROR, '  sample[' + i + '] ' + cohort[i].CaseNumber + '  ' + subj);
}

if (DRY_PREVIEW) {
    System.debug(LoggingLevel.ERROR, 'DRY_PREVIEW = true: nothing enqueued. Flip to false to run.');
} else if (cohort.size() < COHORT_LIMIT) {
    System.debug(LoggingLevel.ERROR, 'Cohort short of target (' + cohort.size()
        + '); widen CANDIDATE_POOL before running.');
} else {
    List<Id> ids = new List<Id>();
    for (Case c : cohort) { ids.add(c.Id); }
    Id jobId = System.enqueueJob(new DraftEvalBatchJob(ids, RUN_LABEL));
    System.debug(LoggingLevel.ERROR, 'Enqueued DraftEvalBatchJob ' + jobId + ' over ' + ids.size()
        + ' cases (~' + Math.ceil(ids.size() / 3.0) + ' chained executions). Monitor with:');
    System.debug(LoggingLevel.ERROR, '  SELECT Status, ExtendedStatus, CreatedDate FROM AsyncApexJob '
        + 'WHERE ApexClass.Name = \'DraftEvalBatchJob\' ORDER BY CreatedDate DESC LIMIT 25');
    System.debug(LoggingLevel.ERROR, 'When the chain finishes, run scripts/apex/fetch_draft_eval.apex.');
}

